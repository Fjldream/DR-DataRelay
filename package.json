{
  "name": "data-relay",
  "version": "0.3.5",
  "private": true,
  "description": "TCP/UDP device data relay to KingHistorian",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:performance": "node tools/performance-test.mjs",
    "build:license-core": "node scripts/build-license-bytecode.mjs build/license-core.jsc",
    "check": "node --check src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "package:offline": "node scripts/build-offline-package.mjs",
    "package:license-tool": "node scripts/build-license-tool-package.mjs",
    "license:tool": "node internal-tools/license-generator.mjs",
    "license:ui": "node internal-tools/license-tool-server.mjs",
    "simulate:10": "node tools/tcp-device-fleet.js 127.0.0.1 9000 10 5000 60",
    "simulate:batch": "node tools/tcp-batch-simulator.js 127.0.0.1 9000 3 5000 60 8 30",
    "simulate:batch:udp": "node tools/tcp-batch-simulator.js 127.0.0.1 9000 3 5000 60 8 30 true udp",
    "simulate:batch:both": "node tools/tcp-batch-simulator.js 127.0.0.1 9000 4 5000 60 8 30 true both"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "bytenode": "^1.7.0",
    "fastify": "^5.6.1",
    "pm2": "^6.0.14",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
